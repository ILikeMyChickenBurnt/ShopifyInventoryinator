{
  "name": "shopify-inventoryinator",
  "version": "1.1.0",
  "description": "Local Shopify order fulfillment tracker",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build:main && npm run build:renderer && electron .",
    "dev": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"wait-on dist/main/main.js && electron .\"",
    "dev:watch": "npm run watch:main",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "postinstall": "npx @electron/rebuild -f -w better-sqlite3",
    "build:app": "npm run build:main && npm run build:renderer",
    "build:win": "npm run build:app && electron-builder --win --publish never",
    "build:linux": "npm run build:app && electron-builder --linux --publish never",
    "release": "electron-builder --publish always",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --watchAll=false",
    "test:coverage:real": "docker compose -f docker-compose.test.yml run --rm coverage",
    "test:real-db-coverage": "docker compose -f docker-compose.test.yml run --rm real-db-coverage",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer && npm run typecheck:tests",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "build:main": "tsc -p tsconfig.main.json",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "clean:main": "node -e \"require('fs').rmSync('dist/main', { recursive: true, force: true })\"",
    "build:renderer": "vite build",
    "watch:renderer": "vite build --watch",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.jest.json",
    "clean:renderer": "node -e \"require('fs').rmSync('dist/renderer', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "shopify",
    "inventory",
    "electron",
    "vue"
  ],
  "author": "ILikeMyChickenBurnt",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^10.0.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.1",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "sql.js": "^1.14.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.10",
    "vue-eslint-parser": "^10.4.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@apollo/client": "^3.8.8",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.3.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "graphql": "^16.8.1",
    "node-fetch": "^2.7.0",
    "vue": "^3.5.34"
  },
  "overrides": {
    "minimatch": "^10.0.1",
    "brace-expansion": "^2.0.3"
  },
  "build": {
    "appId": "com.ilikemychickenburnt.shopify-inventoryinator",
    "productName": "Shopify Inventoryinator",
    "publish": {
      "provider": "github",
      "owner": "ILikeMyChickenBurnt",
      "repo": "ShopifyInventoryinator"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "data/",
        "to": "data/",
        "filter": [
          "!*.json",
          "!*.db",
          "!*.db-shm",
          "!*.db-wal"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Shopify-Inventoryinator-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
