# Dependencies
node_modules/

# Copied vendor files (copied from node_modules during install)
src/renderer/vue.js

# Build output (compiled main process + any other build artifacts)
# The main process is now compiled to dist/main/ during development and production builds.
dist/
out/
coverage/
src/dist/

# Database files
data/*.db
data/*.db-shm
data/*.db-wal

# Config with credentials (shopify-config.json, config.json)
data/*.json
data/electron-session/
data/electron-user-data/

# Environment variables
.env

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Grok Build TUI / local AI assistant configuration (project-scoped)
# This includes local MCP servers, installed plugins, and .grok/config.toml
.grok/

# Generated dependency/security audit reports (created during npm audit / outdated analysis)
audit-report.json
outdated-report.json
npm-outdated.json
*-report.json
*audit*.json
*outdated*.json
